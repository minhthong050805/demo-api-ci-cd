        {
          "name": "Create Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "   pm.test(\"Tạo booking thành công (Status 200)\", function () {\r\n       pm.response.to.have.status(200);\r\n   });\r\n\r\n   pm.test(\"Tên khách hàng khớp với dữ liệu đầu vào\", function () {\r\n       var jsonData = pm.response.json();\r\n       pm.expect(jsonData.booking.firstname).to.eql(\"Nguyen\");\r\n   });\r\n\r\n   var jsonData = pm.response.json();\r\n   pm.environment.set(\"bookingid\", jsonData.bookingid);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "   {\r\n     \"firstname\": \"Nguyen\",\r\n     \"lastname\": \"An\",\r\n     \"totalprice\": 1500,\r\n     \"depositpaid\": true,\r\n     \"bookingdates\": {\r\n       \"checkin\": \"2026-11-01\",\r\n       \"checkout\": \"2026-11-05\"\r\n     },\r\n     \"additionalneeds\": \"Breakfast\"\r\n   }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
